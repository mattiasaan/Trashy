# Copia questo file in .env e modifica i valori

# --- AI ---
# false = solo regex. true = usa l'LLM (se fallisce si torna alle regex)
AI_ENABLED=false

# OpenAI:
#   AI_BASE_URL=            (vuoto)
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o-mini
# Ollama locale (es. Raspberry Pi):
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_API_KEY=ollama
#   AI_MODEL=qwen2.5:3b
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30

# --- Dati ---
RULES_FILE=data/rules_bolzano.json
DB_FILE=data/trashy.db

# --- Frontend ---
# Origini ammesse per CORS, separate da virgola (es. http://localhost:5173)
CORS_ORIGINS=*
