# Copia questo file in .env e modifica i valori. Il file .env NON va mai committato.

# --- AI ---
# false = solo regex. true = usa l'LLM (se fallisce o finisce la quota si torna alle regex)
AI_ENABLED=false

# Google AI Studio (tier gratuito) - chiave da https://aistudio.google.com/apikey
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
# "none" disattiva il ragionamento su Gemini 2.5 Flash (più veloce, meno token).
# Per Gemini 3 usa "low" (non si può disattivare). Lascia vuoto per Ollama/OpenAI.
AI_REASONING_EFFORT=none

# Ollama locale (es. Raspberry Pi):
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_API_KEY=ollama
#   AI_MODEL=qwen2.5:3b
#   AI_REASONING_EFFORT=
#   AI_TIMEOUT=60          (su Raspberry l'LLM locale è lento)
# OpenAI:
#   AI_BASE_URL=            (vuoto)
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o-mini

AI_TIMEOUT=15
AI_MAX_TOKENS=300
# false = prima le regex, AI solo se non trovano nulla (consigliato con il tier gratuito)
AI_FIRST=false
# Massimo di chiamate AI al giorno per tutta l'app. Tienilo sotto la quota del tuo tier.
AI_DAILY_LIMIT=200
# Massimo di chiamate AI al giorno per singolo IP (impedisce a un solo client di esaurire il tetto)
AI_DAILY_LIMIT_PER_IP=15

# --- Rate limiting (richieste al minuto per IP) ---
# Sulla rete mobile molti utenti condividono lo stesso IP: non scendere troppo
RATE_LIMIT_ASK=20
RATE_LIMIT_POINTS=60

# --- Dati ---
RULES_FILE=data/rules_bolzano.json
DB_FILE=data/trashy.db

# --- App / produzione ---
# CORS vale solo per i browser: all'app nativa Expo (Android/iOS) non serve.
# Conta solo se pubblichi anche la versione web di Expo: in quel caso metti solo il suo dominio.
CORS_ORIGINS=
# Log: INFO (consigliato), DEBUG (mostra anche la risposta grezza dell'AI), WARNING
LOG_LEVEL=INFO
# true = /api/health mostra anche lo stato dell'AI e l'ultimo errore (utile per il debug a distanza)
AI_DEBUG=false
# true solo in sviluppo per vedere /docs
DOCS_ENABLED=false
# true se il server è raggiungibile SOLO tramite Cloudflare Tunnel (uvicorn su 127.0.0.1)
TRUST_CF_CONNECTING_IP=false
